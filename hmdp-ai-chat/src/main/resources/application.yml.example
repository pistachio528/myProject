# ============================================================
# 这是配置模板文件，从 GitHub 拉取后请复制为 application.yml 并填入真实值
#
# 使用方法：
#   cp application.yml.example application.yml
#   然后修改下面标注 ⚠️ 的地方
# ============================================================

server:
  port: 8082
  servlet:
    encoding:
      charset: UTF-8
      enabled: true
      force: true

spring:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://localhost:3306/hmdp_seckill?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8&allowPublicKeyRetrieval=true
    username: root
    password: "123456"  # ⚠️ 本地 MySQL 密码

  redis:
    host: localhost
    port: 6379
    lettuce:
      pool:
        max-active: 32
        max-idle: 16
        min-idle: 4

  flyway:
    enabled: true
    locations: classpath:db/migration
    baseline-on-migrate: true

  main:
    web-application-type: servlet

mybatis-plus:
  mapper-locations: classpath:mapper/*.xml
  configuration:
    map-underscore-to-camel-case: true
  global-config:
    db-config:
      logic-delete-field: deleted
      logic-delete-value: 1
      logic-not-delete-value: 0

# ============================================================
# ⚠️ LLM 配置 — 必须填入你的硅基流动 API Key 才能运行智能客服功能
#    获取方式：https://cloud.siliconflow.cn → 个人中心 → API密钥
# ============================================================
ai:
  llm:
    api-url: https://api.siliconflow.cn/v1
    api-key: ${SILICONFLOW_API_KEY:你的硅基流动API-Key填这里}
    model: deepseek-ai/DeepSeek-V3
    temperature: 0.7
    max-tokens: 1024
    timeout-seconds: 120
    embedding-model: BAAI/bge-m3

  # RAG 配置
  rag:
    top-k: 3
    similarity-threshold: 0.70
    chunk-size: 512
    chunk-overlap: 50

  # 对话管理配置
  conversation:
    max-history-rounds: 10
    session-ttl-hours: 24
    inactive-timeout-minutes: 30
    max-context-tokens: 4096

  # 意图识别配置
  intent:
    confidence-threshold-high: 0.7
    confidence-threshold-low: 0.4
    disambiguation-diff-threshold: 0.2

  # 回复质量配置
  quality:
    relevance-threshold: 0.6
    max-retry-count: 2

  # 秒杀系统集成
  seckill:
    base-url: http://localhost:8081

  # 限流配置
  rate-limit:
    enabled: true
    window-seconds: 60
    max-requests-per-window: 10
    max-concurrency: 20

# Milvus 向量数据库配置
milvus:
  host: localhost
  port: 19530
  collection-name: knowledge_chunks
  embedding-dim: 1024
